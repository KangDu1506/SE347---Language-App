<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>se347-3ae48838-e899-44eb-85a7-32f9db827d8b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- File JSON đã được publish mặc định; thêm audio/ảnh của bài học (Storage/LessonTemplate/<LessonId>/...) -->
    <None Update="Storage\LessonTemplate\**\*.mp3;Storage\LessonTemplate\**\*.m4a;Storage\LessonTemplate\**\*.ogg;Storage\LessonTemplate\**\*.wav;Storage\LessonTemplate\**\*.webp;Storage\LessonTemplate\**\*.png;Storage\LessonTemplate\**\*.jpg;Storage\LessonTemplate\**\*.jpeg;Storage\LessonTemplate\**\*.svg" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
