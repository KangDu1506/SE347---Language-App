@page "{id?}"
@*
    Trang cũ /LessonDetail/{id} (đọc thẳng JSON, không kiểm tra khóa bài, XP / "Sao vàng" giả) đã được thay bằng
    /Lesson/{lessonId} gọi API thật (S3-20). Giữ route để link / bookmark cũ chuyển hướng vĩnh viễn sang trang mới.
*@
@functions {
    public IActionResult OnGet(string? id) =>
        string.IsNullOrWhiteSpace(id) || !SE347.DTOs.Lesson.LessonIds.IsValid(id)
            ? RedirectPermanent("/Study")
            : RedirectPermanent($"/Lesson/{Uri.EscapeDataString(id)}");
}
