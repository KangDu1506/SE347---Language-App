@page
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-i18n="global.signup">Đăng ký</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <script src="~/js/signup.js" defer></script>
    </head>
    <body>
        <main class="account-page">
            <a class="account-brand" href="/Index">SE347 Language App</a>
            <section class="account-card" aria-labelledby="signup-title"><div class="account-card__heading"><p class="account-eyebrow">Bắt đầu hành trình</p><h1 id="signup-title">Tạo tài khoản</h1><p>Đăng ký để lưu tiến độ và học mọi lúc.</p></div><form class="account-form" action="/Account/Signup" method="post"><label for="fullName">Họ và tên<input id="fullName" type="text" name="fullName" placeholder="Nguyễn Văn A" autocomplete="name" required></label><label for="email">Email<input id="email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required></label><label for="password">Mật khẩu<input id="password" type="password" name="password" placeholder="Tối thiểu 8 ký tự" autocomplete="new-password" minlength="8" required></label><label class="account-checkbox" for="terms"><input id="terms" type="checkbox" required><span>Tôi đồng ý với điều khoản sử dụng.</span></label><button type="submit">Tiếp tục xác thực</button></form><p class="account-switch">Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p></section>
        </main>
    </body>
</html>