@page
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-i18n="global.signup">Đăng ký</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <partial name="_SupabaseClient" />
        <script src="~/js/signup.js" defer></script>
    </head>
    <body>
        <main class="account-page account-page--auth">
            <a class="account-brand" href="/Index">SE347 Language App</a>
            <section class="auth-layout auth-layout--signup" aria-labelledby="signup-title">
                <div class="auth-layout__side">
                    <div class="auth-mascot" aria-hidden="true">SE</div>
                    <p class="auth-layout__title">Bắt đầu hành trình</p>
                    <p class="auth-layout__text">Tạo tài khoản để lưu tiến độ và học mọi lúc.</p>
                </div>
                <div class="account-card">
                    <div class="account-card__heading">
                        <p class="account-eyebrow">Bắt đầu hành trình</p>
                        <h1 id="signup-title">Tạo tài khoản</h1>
                        <p>Đăng ký để lưu tiến độ và học mọi lúc.</p>
                    </div>
                    <form class="account-form" action="/Account/Signup" method="post" novalidate>
                        <label for="fullName">
                            Họ và tên
                            <input id="fullName" type="text" name="fullName" placeholder="Nguyễn Văn A" autocomplete="name" maxlength="100" required>
                        </label>
                        <label for="username">
                            Tên đăng nhập
                            <input id="username" type="text" name="username" placeholder="NguyenVanA" autocomplete="username" minlength="6" maxlength="32" required>
                        </label>
                        <label for="email">
                            Email
                            <input id="email" type="email" name="email" placeholder="NguyenVanA@example.com" autocomplete="email" maxlength="255" required>
                        </label>
                        <label for="password">
                            Mật khẩu
                            <div class="password-field">
                                <input id="password" type="password" name="password" placeholder="Tối thiểu 16 ký tự" autocomplete="new-password" minlength="16" required>
                                <button class="password-toggle" id="signupPasswordToggle" type="button" aria-controls="password" aria-label="Hiện mật khẩu">Hiện</button>
                            </div>
                        </label>
                        <div class="password-strength" id="passwordStrength" aria-live="polite">
                            <div class="password-strength__bar" aria-hidden="true"><span></span></div>
                            <p class="password-strength__text">Độ mạnh: Chưa có mật khẩu</p>
                        </div>
                        <label class="account-checkbox" for="terms">
                            <input id="terms" type="checkbox" name="terms" required>
                            <span>Tôi đồng ý với <a href="/Account/Terms" target="_blank" rel="noopener noreferrer">Điều khoản sử dụng</a>.</span>
                        </label>
                        <button type="submit">Tạo tài khoản</button>
                    </form>
                    <p class="account-switch">Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p>
                </div>
            </section>
        </main>
    </body>
</html>