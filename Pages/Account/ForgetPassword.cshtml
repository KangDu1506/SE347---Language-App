@page
<!DOCTYPE html>
<html lang="vi">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Quên mật khẩu</title>
		<meta name="description" content="Khôi phục mật khẩu tài khoản"/>
		<link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
		<link rel="stylesheet" href="~/css/Account/Account.css"/>
		<partial name="_SupabaseClient" />
		<script src="~/js/forget-password.js" defer></script>
	</head>
	<body>
		<main class="account-page account-page--auth">
			<section class="auth-layout" aria-labelledby="forgot-title">
				<div class="auth-layout__side">
					<div class="auth-mascot" aria-hidden="true">?</div>
					<p class="auth-layout__title">Lấy lại quyền truy cập</p>
					<p class="auth-layout__text">Chúng tôi sẽ giúp bạn trở lại việc học thật nhanh.</p>
				</div>
				<div class="account-card">
					<div class="account-card__heading">
						<p class="account-eyebrow">Khôi phục tài khoản</p>
						<h1 id="forgot-title">Quên mật khẩu?</h1>
						<p>Nhập email để nhận mã xác thực khôi phục tài khoản.</p>
					</div>

					<form
						class="account-form"
						action="/Account/ForgetPassword"
						method="get">
						<label for="resetEmail">
							Email
							<input
								id="resetEmail"
								type="email"
								name="email"
								placeholder="you@example.com"
								autocomplete="email"
								required />
						</label>
						<button type="submit">Gửi mã xác thực</button>
					</form>

					<p class="account-switch">
						<a href="/Account/Login">Quay lại đăng nhập</a>
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
