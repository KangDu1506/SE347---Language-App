@page
<!DOCTYPE html>
<html lang="vi">
	<head>
        <meta charset="UTF-8">
        <partial name="_PreferencesHead" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title data-i18n="ui.forgot_password">Quên mật khẩu</title>
		<meta name="description" content="Khôi phục mật khẩu tài khoản" data-i18n-content="ui.recover_your_account_password"/>
		<link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
		<link rel="stylesheet" href="~/css/Account/Account.css"/>
		<partial name="_SupabaseClient" />
		<script src="~/js/auth-preferences.js" defer></script>
		<script src="~/js/forget-password.js" defer></script>
	    <link rel="stylesheet" href="~/css/Shared/Preferences.css" asp-append-version="true" />
    </head>
	<body>
        <partial name="_AccountHeader" />
		<main class="account-page account-page--auth">
			<section class="auth-layout" aria-labelledby="forgot-title">
				<div class="auth-layout__side">
					<div class="auth-mascot" aria-hidden="true">?</div>
					<p class="auth-layout__title" data-i18n="ui.regain_access">Lấy lại quyền truy cập</p>
					<p class="auth-layout__text" data-i18n="ui.we_ll_help_you_get_back_to_learning_quickly">Chúng tôi sẽ giúp bạn trở lại việc học thật nhanh.</p>
				</div>
				<div class="account-card">
					<div class="account-card__heading">
						<p class="account-eyebrow" data-i18n="ui.account_recovery">Khôi phục tài khoản</p>
						<h1 id="forgot-title" data-i18n="ui.forgot_password">Quên mật khẩu?</h1>
						<p data-i18n="ui.enter_your_email_to_receive_an_account_recovery_code">Nhập email để nhận mã xác thực khôi phục tài khoản.</p>
					</div>

					<form
						class="account-form"
						action="/Account/ForgetPassword"
						method="get">
						<label for="resetEmail">
							<span data-i18n="forgot.email">Email</span>
							<input
								id="resetEmail"
								type="email"
								name="email"
								placeholder="you@example.com"
								autocomplete="email"
								required />
						</label>
						<button type="submit" data-i18n="ui.send_verification_code">Gửi mã xác thực</button>
					</form>

					<p class="account-switch">
						<a href="/Account/Login" data-i18n="ui.back_to_sign_in">Quay lại đăng nhập</a>
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
