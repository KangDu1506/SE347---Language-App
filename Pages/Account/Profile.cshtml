@page
<!DOCTYPE html>
<html lang="vi">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Hồ sơ</title>
		<link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
		<link rel="stylesheet" href="~/css/Account/Profile.css"/>
		<script src="~/js/auth-guard.js" defer></script>
		<script src="~/js/profile.js" defer></script>
	</head>
	<body>
		<main class="profile-page">
			<header class="profile-topbar">
				<a class="profile-brand" href="/Index">SE347 Language App</a>
				<nav class="profile-nav" aria-label="Điều hướng hồ sơ">
					<a href="/Index">Trang chủ</a>
					<a href="/Study">Học tập</a>
					<a class="profile-nav__active" href="/Account/Profile" aria-current="page">Hồ sơ</a>
				</nav>
				<a class="profile-logout" href="/Account/Login?logout=1">Đăng xuất</a>
			</header>

			<section class="profile-hero" aria-labelledby="profile-title">
				<div class="profile-avatar" aria-hidden="true">NA</div>
				<div class="profile-identity">
					<p class="profile-eyebrow">Tài khoản cá nhân</p>
					<h1 id="profile-title">Nguyễn Văn C</h1>
					<p class="profile-email">nguyen.van.c@example.com</p>
				</div>
				<button class="profile-edit-button" type="button">Chỉnh sửa hồ sơ</button>
			</section>

			<section class="profile-stats" aria-label="Thống kê học tập">
				<article class="profile-stat">
					<span class="profile-stat__label">Ngày học liên tục</span>
					<strong>12</strong>
					<span class="profile-stat__note">ngày</span>
				</article>
				<article class="profile-stat">
					<span class="profile-stat__label">Bài đã hoàn thành</span>
					<strong>48</strong>
					<span class="profile-stat__note">bài học</span>
				</article>
				<article class="profile-stat">
					<span class="profile-stat__label">Điểm tích lũy</span>
					<strong>2,840</strong>
					<span class="profile-stat__note">XP</span>
				</article>
			</section>

			<div class="profile-content">
				<section class="profile-panel profile-progress-panel" aria-labelledby="progress-title">
					<div class="profile-panel__heading">
						<div>
							<p class="profile-eyebrow">Mục tiêu tuần này</p>
							<h2 id="progress-title">Tiến độ học tập</h2>
						</div>
						<span class="profile-progress-value">72%</span>
					</div>
					<div class="profile-progress-track" role="progressbar" aria-label="Tiến độ học tập tuần này" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100">
						<span style="width: 72%"></span>
					</div>
					<p class="profile-panel__description">Bạn đã hoàn thành 18 trên 25 hoạt động trong tuần này.</p>
					<a class="profile-panel__link" href="/Study">Tiếp tục học <span aria-hidden="true">&#8594;</span></a>
				</section>

				<section class="profile-panel" aria-labelledby="activity-title">
					<div class="profile-panel__heading">
						<div>
							<p class="profile-eyebrow">Theo dõi gần đây</p>
							<h2 id="activity-title">Hoạt động mới nhất</h2>
						</div>
						<a class="profile-panel__link" href="/Study">Xem tất cả</a>
					</div>
					<ul class="profile-activity-list">
						<li>
							<span class="profile-activity-icon profile-activity-icon--blue" aria-hidden="true">V</span>
							<span><strong>Từ vựng cơ bản</strong><small>Hoàn thành hôm nay</small></span>
							<b>+120 XP</b>
						</li>
						<li>
							<span class="profile-activity-icon profile-activity-icon--green" aria-hidden="true">N</span>
							<span><strong>Ngữ pháp hiện tại đơn</strong><small>Hoàn thành hôm qua</small></span>
							<b>+90 XP</b>
						</li>
						<li>
							<span class="profile-activity-icon profile-activity-icon--orange" aria-hidden="true">T</span>
							<span><strong>Bài kiểm tra thử số 04</strong><small>Hoàn thành 2 ngày trước</small></span>
							<b>+180 XP</b>
						</li>
					</ul>
				</section>
			</div>

			<nav class="profile-tabbar" aria-label="Điều hướng chính">
				<a href="/Index">Trang chủ</a>
				<a href="/Study">Học</a>
				<a href="/TrialTest">Thi thử</a>
				<a href="/Ranking">Xếp hạng</a>
				<a class="profile-tabbar__active" href="/Account/Profile" aria-current="page">Hồ sơ</a>
			</nav>
		</main>
	</body>
</html>
