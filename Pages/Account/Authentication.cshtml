@page
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Xác thực tài khoản</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <script src="~/js/authentication.js" defer></script>
    </head>
    <body>
        <main class="account-page">
            <a class="account-brand" href="/Account/Login">SE347 Language App</a>

            <section class="account-card" aria-labelledby="authentication-title">
                <div class="account-card__heading">
                    <p class="account-eyebrow">Bảo mật tài khoản</p>
                    <h1 id="authentication-title">Xác thực tài khoản</h1>
                    <p>Nhập mã mặc định <strong>123456</strong> để tiếp tục.</p>
                </div>

                <form
                    class="account-form"
                    action="/Account/Authentication"
                    method="get">
                    <label for="verificationCode">Mã xác thực</label>
                    <input
                        id="verificationCode"
                        class="verification-code"
                        type="text"
                        name="code"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        placeholder="123456"
                        required />
                    <button id="verificationSubmit" type="submit">Xác nhận</button>
                </form>

                <p class="account-switch">
                    Đã có tài khoản?
                    <a href="/Account/Login">Quay lại đăng nhập</a>
                </p>
            </section>
        </main>
    </body>
</html>