@page
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-page-title="auth.page">Xác thực tài khoản</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <partial name="_SupabaseClient" />
        <script src="~/js/auth-preferences.js" defer></script>
        <script src="~/js/authentication.js" defer></script>
    </head>
    <body>
        <div class="account-preferences" aria-label="Tùy chọn hiển thị">
            <button type="button" data-theme-toggle>
                <span data-theme-icon aria-hidden="true">☾</span>
                <span data-theme-label>Giao diện</span>
            </button>
            <button type="button" data-language-toggle aria-label="English">English</button>
        </div>
        <main class="account-page account-page--auth">
            <section class="auth-layout auth-layout--verification" aria-labelledby="authentication-title">
                <div class="auth-layout__side">
                    <div class="auth-mascot" aria-hidden="true">6</div>
                    <p class="auth-layout__title" data-i18n="auth.sideTitle">Một bước nữa thôi</p>
                    <p class="auth-layout__text" data-i18n="auth.sideText">Xác thực để bảo vệ tài khoản và tiếp tục hành trình.</p>
                </div>
                <div class="account-card">
                    <div class="account-card__heading">
                        <p class="account-eyebrow" data-i18n="auth.eyebrow">Bảo mật tài khoản</p>
                        <h1 id="authentication-title" data-i18n="auth.title">Kiểm tra email</h1>
                        <p><span data-i18n="auth.instructions">Nhập mã 6 số đã gửi tới</span><br><strong id="verificationEmail">h***@@gmail.com</strong> · <a id="changeEmailLink" href="/Account/Signup" data-i18n="auth.changeEmail">Đổi email</a></p>
                    </div>

                    <form
                        class="account-form"
                        action="/Account/Authentication"
                        method="get">
                        <label class="verification-label" for="verificationDigit1">
                            <span data-i18n="auth.code">Mã xác thực</span>
                            <span class="verification-hint" data-i18n="auth.keyboardHint">(vui lòng tắt bộ gõ tiếng Việt để nhập)</span>
                        </label>
                        <div class="verification-inputs" aria-label="Mã xác thực gồm 6 số" data-i18n-aria-label="auth.codeGroup">
                            <input id="verificationDigit1" type="text" inputmode="numeric" maxlength="1" aria-label="Số 1" data-i18n-aria-label="auth.digit1" autocomplete="one-time-code" autofocus required>
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="Số 2" data-i18n-aria-label="auth.digit2" required>
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="Số 3" data-i18n-aria-label="auth.digit3" required>
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="Số 4" data-i18n-aria-label="auth.digit4" required>
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="Số 5" data-i18n-aria-label="auth.digit5" required>
                            <input type="text" inputmode="numeric" maxlength="1" aria-label="Số 6" data-i18n-aria-label="auth.digit6" required>
                        </div>
                        <button id="verificationSubmit" type="submit" disabled data-i18n="auth.submit">Xác nhận</button>
                    </form>
                    <p class="verification-resend account-switch"><span data-i18n="auth.noCode">Chưa nhận được mã?</span> <a href="/Account/Authentication" data-i18n="auth.resend">Gửi lại</a></p>
                    <p class="account-switch">
                        <span data-i18n="auth.haveAccount">Đã có tài khoản?</span>
                        <a href="/Account/Login" data-i18n="auth.login">Quay lại đăng nhập</a>
                    </p>
                </div>
            </section>
        </main>
    </body>
</html>