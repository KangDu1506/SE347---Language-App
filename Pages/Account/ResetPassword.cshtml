@page
<!DOCTYPE html>
<html lang="vi">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Đặt mật khẩu mới</title>
		<meta name="description" content="Đặt mật khẩu mới cho tài khoản"/>
		<link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
		<link rel="stylesheet" href="~/css/Account/Account.css"/>
		<partial name="_SupabaseClient" />
		<script src="~/js/reset-password.js" defer></script>
	</head>
	<body>
		<main class="account-page account-page--auth">
			<section class="auth-layout" aria-labelledby="reset-title">
				<div class="auth-layout__side">
					<div class="auth-mascot" aria-hidden="true">*</div>
					<p class="auth-layout__title">Sắp xong rồi</p>
					<p class="auth-layout__text">Chọn mật khẩu mới để tiếp tục việc học.</p>
				</div>
				<div class="account-card">
					<div class="account-card__heading">
						<p class="account-eyebrow">Khôi phục tài khoản</p>
						<h1 id="reset-title">Đặt mật khẩu mới</h1>
						<p>Mật khẩu mới cần tối thiểu 8 ký tự.</p>
					</div>

					<form class="account-form" action="/Account/ResetPassword" method="post" novalidate>
						<label for="newPassword">
							Mật khẩu mới
							<div class="password-field">
								<input id="newPassword" type="password" name="password" placeholder="Tối thiểu 8 ký tự" autocomplete="new-password" minlength="8" required>
								<button class="password-toggle" id="newPasswordToggle" type="button" aria-controls="newPassword" aria-label="Hiện mật khẩu">Hiện</button>
							</div>
						</label>
						<label for="confirmPassword">
							Nhập lại mật khẩu mới
							<input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required>
						</label>
						<button type="submit">Đổi mật khẩu</button>
					</form>

					<p class="account-switch">
						<a href="/Account/Login">Quay lại đăng nhập</a>
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
