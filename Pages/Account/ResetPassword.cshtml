@page
<!DOCTYPE html>
<html lang="vi">
	<head>
        <meta charset="UTF-8">
        <partial name="_PreferencesHead" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title data-i18n="ui.set_a_new_password">Đặt mật khẩu mới</title>
		<meta name="description" content="Đặt mật khẩu mới cho tài khoản" data-i18n-content="ui.set_a_new_password_for_your_account"/>
		<link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
		<link rel="stylesheet" href="~/css/Account/Account.css"/>
		<partial name="_SupabaseClient" />
		<script src="~/js/reset-password.js" defer></script>
	    <link rel="stylesheet" href="~/css/Shared/Preferences.css" asp-append-version="true" />
    </head>
	<body>
        <partial name="_AccountHeader" />
		<main class="account-page account-page--auth">
			<section class="auth-layout" aria-labelledby="reset-title">
				<div class="auth-layout__side">
					<div class="auth-mascot" aria-hidden="true">*</div>
					<p class="auth-layout__title" data-i18n="ui.almost_done">Sắp xong rồi</p>
					<p class="auth-layout__text" data-i18n="ui.choose_a_new_password_to_continue_learning">Chọn mật khẩu mới để tiếp tục việc học.</p>
				</div>
				<div class="account-card">
					<div class="account-card__heading">
						<p class="account-eyebrow" data-i18n="ui.account_recovery">Khôi phục tài khoản</p>
						<h1 id="reset-title" data-i18n="ui.set_a_new_password">Đặt mật khẩu mới</h1>
						<p data-i18n="ui.your_new_password_must_contain_at_least_8_characters">Mật khẩu mới cần tối thiểu 8 ký tự.</p>
					</div>

					<form class="account-form" action="/Account/ResetPassword" method="post" novalidate>
						<label for="newPassword">
							<span data-i18n="ui.new_password">Mật khẩu mới</span>
							<div class="password-field">
								<input id="newPassword" type="password" name="password" placeholder="Tối thiểu 8 ký tự" data-i18n-placeholder="ui.at_least_8_characters" autocomplete="new-password" minlength="8" required>
								<button class="password-toggle" id="newPasswordToggle" type="button" aria-controls="newPassword confirmPassword" aria-pressed="false" aria-label="Hiện mật khẩu" data-i18n-aria-label="ui.show_password" title="Hiện mật khẩu" data-i18n-title="ui.show_password"><partial name="_PasswordVisibilityIcon" /></button>
							</div>
						</label>
						<div class="password-strength" id="passwordStrength" aria-live="polite">
							<div class="password-strength__bar" aria-hidden="true"><span></span></div>
							<p class="password-strength__text">Độ mạnh: Chưa có mật khẩu</p>
						</div>
						<label for="confirmPassword">
							<span data-i18n="ui.confirm_new_password">Nhập lại mật khẩu mới</span>
							<input id="confirmPassword" type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required>
						</label>
						<button type="submit" data-i18n="ui.change_password">Đổi mật khẩu</button>
					</form>

					<p class="account-switch">
						<a href="/Account/Login" data-i18n="ui.back_to_sign_in">Quay lại đăng nhập</a>
					</p>
				</div>
			</section>
		</main>
	</body>
</html>
