@page
<!-- Login Page -->
<!-- Summary:
    This is the login page of the application.
-->

<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-page-title="page.login">Đăng nhập</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <partial name="_SupabaseClient" />
        <script src="~/js/auth-preferences.js" defer></script>
        <script src="~/js/login.js" defer></script>
    </head>
    <body>
        <div class="account-preferences" aria-label="Tùy chọn hiển thị">
            <button type="button" data-theme-toggle>
                <span data-theme-icon aria-hidden="true">☾</span>
                <span data-theme-label>Giao diện</span>
            </button>
            <button type="button" data-language-toggle aria-label="English">English</button>
        </div>
        <main class="account-page account-page--auth">
            <section class="auth-layout" aria-labelledby="login-title">
                <div class="auth-layout__side">
                    <div class="auth-mascot" aria-hidden="true">SE</div>
                    <p class="auth-layout__title" data-i18n="login.sideTitle">Mỗi ngày một chút,<br>tiến bộ thật nhiều</p>
                    <p class="auth-layout__text" data-i18n="login.sideText">Tiếp tục hành trình học tiếng Anh của bạn.</p>
                </div>
                <div class="account-card login-card">
                    <div class="account-card__heading">
                        <p class="account-eyebrow" data-i18n="login.eyebrow">Chào mừng trở lại</p>
                        <h1 id="login-title" data-i18n="login.submit">Đăng nhập</h1>
                        <p data-i18n="login.subtitle">Đăng nhập để tiếp tục hành trình học tập.</p>
                    </div>
                    <form class="account-form" method="post" action="/Account/Login">
                        <label for="username">
                            <span data-i18n="login.email">Email</span>
                            <input
                                type="text"
                                id="username"
                                name="username"
                                autocomplete="username"
                                required />
                        </label>
                        <label for="password">
                            <span data-i18n="login.password">Mật khẩu</span>
                            <div class="password-field">
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    autocomplete="current-password"
                                    required />
                                <button class="password-toggle" id="passwordToggle" type="button" aria-controls="password" aria-label="Hiện mật khẩu" data-i18n-aria-label="password.show" data-i18n="password.show">Hiện</button>
                            </div>
                        </label>
                        <div class="login-options">
                            <label class="account-checkbox" for="rememberLogin">
                                <input id="rememberLogin" type="checkbox" />
                                <span data-i18n="login.remember">Ghi nhớ đăng nhập</span>
                            </label>
                            <a class="login-forgot-link" href="/Account/ForgetPassword" data-i18n="login.forgot">Quên mật khẩu?</a>
                        </div>
                        <button type="submit" data-i18n="login.submit">Đăng nhập</button>
                    </form>
                    <hr>
                    <p data-i18n="login.or">Hoặc đăng nhập với</p>
                    <div class="other-login-button-container">
                        <button
                            type="button"
                            class="other-login-button google-login">
                            <span data-i18n="login.google">Google</span>
                            <img
                                src="~/images/GoogleIcon.webp"
                                class="login-button-logo" />
                        </button>
                    </div>

                    <p class="account-switch login-signup-prompt">
                        <span data-i18n="login.noAccount">Chưa có tài khoản?</span>
                        <a href="/Account/Signup" data-i18n="login.signup">Đăng ký</a>
                    </p>
                </div>
            </section>
        </main>
    </body>
</html>