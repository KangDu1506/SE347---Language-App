@page
<!-- Login Page -->
<!-- Summary:
    This is the login page of the application.
-->

<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-i18n="global.login">Đăng nhập</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <script src="~/js/login.js" defer></script>
    </head>
    <body>
        <main class="account-page account-page--auth">
            <section class="auth-layout" aria-labelledby="login-title">
                <div class="auth-layout__side">
                    <div class="auth-mascot" aria-hidden="true">SE</div>
                    <p class="auth-layout__title">Mỗi ngày một chút,<br>tiến bộ thật nhiều</p>
                    <p class="auth-layout__text">Tiếp tục hành trình học tiếng Anh của bạn.</p>
                </div>
                <div class="account-card login-card">
                    <div class="account-card__heading">
                        <p class="account-eyebrow">Chào mừng trở lại</p>
                        <h1 id="login-title" data-i18n="global.login">Đăng nhập</h1>
                        <p>Đăng nhập để tiếp tục hành trình học tập.</p>
                    </div>
                    <form class="account-form" method="post" action="/Account/Login">
                        <label for="username" data-i18n="global.username">
                            Email hoặc tên đăng nhập
                            <input
                                type="text"
                                id="username"
                                name="username"
                                autocomplete="username"
                                required />
                        </label>
                        <label for="password" data-i18n="global.password">
                            Mật khẩu
                            <div class="password-field">
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    autocomplete="current-password"
                                    required />
                                <button class="password-toggle" id="passwordToggle" type="button" aria-controls="password" aria-label="Hiện mật khẩu">Hiện</button>
                            </div>
                        </label>
                        <div class="login-options">
                            <label class="account-checkbox" for="rememberLogin">
                                <input id="rememberLogin" type="checkbox" />
                                <span>Ghi nhớ đăng nhập</span>
                            </label>
                            <a class="login-forgot-link" href="/Account/ForgetPassword">Quên mật khẩu?</a>
                        </div>
                        <button type="submit" data-i18n="global.login">Đăng nhập</button>
                    </form>
                    <hr>
                    <p data-i18n="login.or-login-with">Hoặc đăng nhập với</p>
                    <div class="other-login-button-container">
                        <button
                            type="button"
                            class="other-login-button google-login"
                            data-i18n="login.google-login">
                            Google
                            <img
                                src="~/images/GoogleIcon.webp"
                                class="login-button-logo" />
                        </button>
                    </div>

                    <p class="account-switch login-signup-prompt">
                        Chưa có tài khoản?
                        <a href="/Account/Signup">Đăng ký</a>
                    </p>
                </div>
            </section>
        </main>
    </body>
</html>