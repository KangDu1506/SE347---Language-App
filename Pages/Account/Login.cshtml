@page
<!-- Login Page -->
<!-- Summary:
    This is the login page of the application.
-->

<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-i18n="global.login">Đăng nhập</title>
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css"/>
        <link rel="stylesheet" href="~/css/Account/Account.css"/>
        <script src="~/js/login.js" defer></script>
    </head>
    <body>
        <main class="account-page">
        <section class="login-card" aria-labelledby="login-title">
            <h2 id="login-title" data-i18n="global.login">Đăng nhập</h2>
            <form method="post" action="/Account/Login">
                <label for="username" data-i18n="global.username">Tên đăng nhập</label>
                <input
                    type="text"
                    id="username"
                    name="username"
                    autocomplete="username"
                    required />
                <label for="password" data-i18n="global.password">Mật khẩu</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    autocomplete="current-password"
                    required />
                <button type="submit" data-i18n="global.login">Đăng nhập</button>
            </form>
            <hr>
            <p data-i18n="login.or-login-with">Hoặc đăng nhập với</p>
            <div class="other-login-button-container">
                <button
                    type="button"
                    class="other-login-button google-login"
                    data-i18n="login.google-login">
                    Google
                    <img
                        src="~/images/GoogleIcon.webp"
                        class="login-button-logo" />
                </button>
                <button
                    type="button"
                    class="other-login-button facebook-login"
                    data-i18n="login.facebook-login">
                    Facebook
                </button>
            </div>

                <nav class="login-actions" aria-label="Tùy chọn tài khoản">
                    <a
                        class="login-action-button login-action-button--primary"
                        href="/Account/Signup"
                        role="button">
                        Đăng ký
                    </a>
                    <a
                        class="login-action-button login-action-button--secondary"
                        href="/Account/ForgetPassword"
                        role="button">
                        Quên mật khẩu?
                    </a>
                </nav>
            </section>
        </main>
    </body>
</html>