@page
@*
    Index
    Summary:
    Dashboard sau khi đăng nhập (phong cách sticker).
    Số liệu, bài đang học và gợi ý được tải từ /api/progress và /api/lessons.
*@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_SupabaseClient" />
    <script src="~/js/Shared/api.js" asp-append-version="true" defer></script>
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/dashboard-data.js" asp-append-version="true" defer></script>
    <script src="~/js/index.js" asp-append-version="true" defer></script>
}

<main class="home-page dash" data-dashboard-state="loading" data-dashboard-mode="loading">
    <div class="dash-wrap">
        <section class="dash-hero" aria-labelledby="dash-title">
            <div class="dash-hero__copy">
                <span class="tag" data-i18n="dash.tag">Tổng quan học tập</span>
                <h1 id="dash-title">
                    <span data-i18n="dash.hello">Chào</span> <span data-user-name data-i18n="dash.friend">bạn</span>!<br>
                    <span class="dash-hl" data-i18n="dash.hero_today">Cùng xem tiến độ thật của bạn.</span>
                </h1>
                <p data-dashboard-summary aria-live="polite">Đang tải tiến độ học tập…</p>
            </div>
            <div class="dash-streak" data-dashboard-streak role="img" hidden>
                <span class="dash-streak__tag" data-i18n="dash.streak_tag">Chuỗi hiện tại</span>
                <svg class="dash-streak__flame" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c.6 3.2 4.5 5.2 4.5 9.7a4.5 4.5 0 0 1-9 0c0-1.6.6-2.8 1.5-3.8.2 1.4.9 2.3 1.8 2.6C10.4 8 11 5 12 2.5z" /></svg>
                <strong data-stat="streak">—</strong>
                <span data-i18n="dash.day_streak">ngày liền</span>
                <small data-stat="longest-streak"></small>
            </div>
        </section>
    </div>

    <section class="dash-wrap dash-state" data-dashboard-view="loading" aria-live="polite" aria-busy="true">
        <span class="visually-hidden" data-i18n="dash.loading">Đang tải tiến độ học tập…</span>
        <div class="dash-skeleton" aria-hidden="true">
            <i></i><i></i><i></i>
            <i></i>
            <i></i><i></i>
        </div>
    </section>

    <div class="dash-wrap dash-state" data-dashboard-view="error" hidden>
        <section class="sticker dash-message" role="alert">
            <span class="tag" data-i18n="dash.error_tag">Sự cố kết nối</span>
            <h2 data-error-title>Chưa tải được trang chủ</h2>
            <p data-error-text>Không tải được tiến độ học tập. Vui lòng thử lại.</p>
            <button class="btn btn--ink" type="button" data-dashboard-retry data-i18n="dash.retry">Thử lại</button>
        </section>
    </div>

    <div class="dash-wrap" data-dashboard-view="ready" hidden>
        <section class="dash-stats" aria-label="Số liệu học tập" data-i18n-aria-label="dash.stats_label">
            <article class="sticker dash-stat dash-stat--xp">
                <span class="tag" data-i18n="dash.stat_xp">Tổng XP</span>
                <strong data-stat="total-xp">—</strong>
                <p data-stat="today-xp"></p>
            </article>
            <article class="sticker dash-stat dash-stat--done">
                <span class="tag" data-i18n="dash.stat_completed">Bài đã hoàn thành</span>
                <strong data-stat="lessons-completed">—</strong>
                <p data-stat="completed-meta"></p>
            </article>
            <article class="sticker dash-stat dash-stat--active">
                <span class="tag" data-i18n="dash.stat_in_progress">Bài đang học</span>
                <strong data-stat="lessons-in-progress">—</strong>
                <p data-stat="in-progress-meta"></p>
            </article>
            <article class="sticker dash-stat dash-stat--completion">
                <span class="tag" data-i18n="dash.stat_completion">Tiến độ tổng</span>
                <div class="dash-stat__completion">
                    <strong data-completion-percent>—</strong>
                    <div class="dash-bar" data-completion-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-i18n-aria-label="dash.stat_completion"><i></i></div>
                </div>
                <p data-completion-meta></p>
            </article>
        </section>

        <div class="dash-bento">
            <section class="sticker dash-continue" aria-labelledby="dash-current-title">
                <span class="tag" data-current-tag data-i18n="dash.continue_tag">Bài đang học</span>
                <h2 id="dash-current-title" data-current-title></h2>
                <p data-current-text></p>
                <p class="dash-continue__meta" data-current-meta></p>
                <p class="dash-continue__date" data-current-date hidden></p>
                <div class="dash-bar" data-current-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden><i></i></div>
                <a class="btn btn--ink btn--lg" data-current-link hidden></a>
                <svg class="foxy dash-continue__fox" aria-hidden="true"><use href="/images/mascot/foxy.svg#foxy" /></svg>
            </section>

            <section class="sticker dash-recs" aria-labelledby="dash-recs-title">
                <span class="tag" data-i18n="dash.recs_tag">Dành cho bạn</span>
                <h2 id="dash-recs-title" data-i18n="dash.recs_title">Bài học gợi ý</h2>
                <p data-i18n="dash.recs_text">Các bài chưa hoàn thành, theo thứ tự của ứng dụng.</p>
                <ol class="dash-rec-list" data-recommendations></ol>
                <p class="dash-recs__empty" data-recs-empty hidden></p>
            </section>
        </div>
    </div>
</main>
