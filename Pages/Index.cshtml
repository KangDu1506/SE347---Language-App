@page
@*
    Index
    Summary:
    This is the main index page of the application.
*@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" />
}

@section Scripts {
    <partial name="_SupabaseClient" />
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/index.js" defer></script>
}

        <main class="home-page">
            <section class="home-hero" aria-labelledby="home-title">
                <div class="home-hero__content">
                    <p class="home-eyebrow" data-i18n="ui.welcome_back">Chào mừng bạn trở lại</p>
                    <h1 id="home-title" data-i18n="ui.one_step_closer_to_your_goal_every_day">Mỗi ngày một bước gần hơn đến mục tiêu.</h1>
                    <p data-i18n="ui.learn_vocabulary_practise_grammar_and_track_your_progress_in_one_learning_space">Học từ vựng, luyện ngữ pháp và kiểm tra tiến độ trong một không gian học tập rõ ràng.</p>
                    <div class="home-actions">
                        <a class="home-button home-button--primary" href="/Study" data-i18n="ui.start_learning">Bắt đầu học</a>
                        <a class="home-button home-button--secondary" href="/TrialTest" data-i18n="ui.try_a_test">Làm bài thử</a>
                    </div>
                </div>
                <div class="home-hero__visual" aria-label="Tiến độ học tập hiện tại" data-i18n-aria-label="ui.current_learning_progress">
                    <div class="home-progress-ring"><strong>68%</strong><span data-i18n="ui.progress">tiến độ</span></div>
                    <div class="home-streak"><strong>12</strong><span data-i18n="ui.day_streak">ngày liên tục</span></div>
                </div>
            </section>

            <section class="home-section" aria-labelledby="home-continue-title">
                <div class="home-section__heading">
                    <div><p class="home-eyebrow" data-i18n="ui.your_learning_path">Lộ trình của bạn</p><h2 id="home-continue-title" data-i18n="ui.continue_learning">Tiếp tục học</h2></div>
                    <a href="/Study" data-i18n="ui.view_all_link">Xem tất cả &#8594;</a>
                </div>
                <div class="home-course-grid">
                    <a class="home-course-card home-course-card--blue" href="/Study">
                        <span class="home-course-card__icon">A1</span><span class="home-course-card__level" data-i18n="ui.beginner">Cơ bản</span>
                        <strong data-i18n="ui.everyday_vocabulary">Từ vựng hằng ngày</strong><span data-i18n="ui.12_lessons_35_minutes">12 bài học &#183; 35 phút</span>
                    </a>
                    <a class="home-course-card home-course-card--green" href="/Study">
                        <span class="home-course-card__icon">G</span><span class="home-course-card__level" data-i18n="ui.practice">Luyện tập</span>
                        <strong data-i18n="ui.grammar_foundations">Ngữ pháp nền tảng</strong><span data-i18n="ui.8_lessons_25_minutes">8 bài học &#183; 25 phút</span>
                    </a>
                    <a class="home-course-card home-course-card--orange" href="/TrialTest">
                        <span class="home-course-card__icon">&#9733;</span><span class="home-course-card__level" data-i18n="ui.challenge">Thử thách</span>
                        <strong data-i18n="ui.comprehensive_test">Kiểm tra tổng hợp</strong><span data-i18n="ui.20_questions_15_minutes">20 câu hỏi &#183; 15 phút</span>
                    </a>
                </div>
            </section>
        </main>
