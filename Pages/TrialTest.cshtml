@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Làm bài thử";
    ViewData["NoticeSectionKey"] = "ui.practice_test";
    ViewData["NoticeSectionFallback"] = "Thi thử";
    ViewData["NoticeDescriptionKey"] = "ui.trial_in_development_desc";
    ViewData["NoticeDescriptionFallback"] = "Tính năng thi thử đang được xây dựng và sẽ sớm ra mắt. Bạn hãy tiếp tục luyện tập ở mục Học tập nhé!";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Shared/UnderDevelopment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/TrialTest.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_SupabaseClient" />
    <script src="~/js/auth-guard.js" asp-append-version="true" defer></script>
    <script src="~/js/trialtest.js" asp-append-version="true" defer></script>
}

<main class="trial-page dev-notice-page">
    <partial name="_UnderDevelopmentNotice" />
</main>
