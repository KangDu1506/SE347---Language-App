@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Làm bài thử";
    ViewData["ShowHeader"] = false;
    ViewData["ShowFooter"] = false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/TrialTest.css" />
}

@section Scripts {
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/trialtest.js" defer></script>
}

		<main class="trial-page">
			<header class="trial-topbar"><span class="trial-counter">Câu hỏi <strong>04</strong> / 20</span><a href="/Study">Thoát bài kiểm tra</a></header>
			<div class="trial-progress"><span></span></div>
			<section class="trial-layout">
				<div class="trial-question-card">
					<p class="trial-eyebrow">Từ vựng &#183; Bài kiểm tra thử</p>
					<h1>Chọn từ phù hợp với nghĩa của câu sau:</h1>
					<p class="trial-question">I usually ______ breakfast at seven o'clock.</p>
					<div class="trial-options" role="radiogroup" aria-label="Các lựa chọn trả lời">
						<label class="trial-option"><input type="radio" name="answer" value="have"><span class="trial-option__key">A</span><span>have</span></label>
						<label class="trial-option"><input type="radio" name="answer" value="has"><span class="trial-option__key">B</span><span>has</span></label>
						<label class="trial-option"><input type="radio" name="answer" value="having"><span class="trial-option__key">C</span><span>having</span></label>
						<label class="trial-option"><input type="radio" name="answer" value="had"><span class="trial-option__key">D</span><span>had</span></label>
					</div>
					<div class="trial-actions"><button class="trial-secondary" type="button">Câu trước</button><button class="trial-primary" type="button">Câu tiếp theo &#8594;</button></div>
				</div>
				<aside class="trial-sidebar"><div class="trial-timer"><span>Thời gian còn lại</span><strong>12:45</strong></div><div class="trial-question-map"><h2>Danh sách câu hỏi</h2><div class="trial-number-grid"><button class="is-done" type="button">1</button><button class="is-done" type="button">2</button><button class="is-done" type="button">3</button><button class="is-current" type="button">4</button><button type="button">5</button><button type="button">6</button><button type="button">7</button><button type="button">8</button><button type="button">9</button><button type="button">10</button><button type="button">11</button><button type="button">12</button></div></div></aside>
			</section>
		</main>
