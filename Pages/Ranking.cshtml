@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bảng xếp hạng";
    ViewData["NoticeSectionKey"] = "ui.leaderboard";
    ViewData["NoticeSectionFallback"] = "Bảng xếp hạng";
    ViewData["NoticeDescriptionKey"] = "ui.ranking_in_development_desc";
    ViewData["NoticeDescriptionFallback"] = "Tính năng bảng xếp hạng đang được xây dựng và sẽ sớm ra mắt. Bạn hãy tiếp tục học tập và quay lại sau nhé!";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Shared/UnderDevelopment.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Ranking.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_SupabaseClient" />
    <script src="~/js/auth-guard.js" asp-append-version="true" defer></script>
    <script src="~/js/ranking.js" asp-append-version="true" defer></script>
}

<main class="ranking-page dev-notice-page">
    <partial name="_UnderDevelopmentNotice" />
</main>
