@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Bảng xếp hạng";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Ranking.css" />
}

@section Scripts {
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/ranking.js" defer></script>
}

		<main class="ranking-page">
			<header class="ranking-header"><div><a class="ranking-brand" href="/Index">SE347 Language App</a><p class="ranking-eyebrow" data-i18n="ui.learning_community">Cộng đồng học tập</p><h1 data-i18n="ui.leaderboard">Bảng xếp hạng</h1><p data-i18n="ui.compete_with_this_week_s_most_active_learners">Thi đua cùng những người học tích cực nhất tuần này.</p></div><a class="ranking-profile" href="/Account/Profile" data-i18n-text="ui.profile">Hồ sơ <span>NA</span></a></header>
			<nav class="ranking-tabs" aria-label="Phạm vi bảng xếp hạng" data-i18n-aria-label="ui.leaderboard_period"><button class="ranking-tab ranking-tab--active" type="button" data-i18n="ui.this_week">Tuần này</button><button class="ranking-tab" type="button" data-i18n="ui.this_month">Tháng này</button><button class="ranking-tab" type="button" data-i18n="ui.all">Tất cả</button></nav>
			<section class="ranking-table-wrap" aria-labelledby="ranking-title"><div class="ranking-table-heading"><h2 id="ranking-title" data-i18n="ui.top_learners">Top người học</h2><span data-i18n="ui.xp_points">Điểm XP</span></div><div class="ranking-table"><div class="ranking-row ranking-row--header"><span data-i18n="ui.rank">Hạng</span><span data-i18n="ui.learner">Người học</span><span data-i18n="ui.progress">Tiến độ</span><span data-i18n="ui.points">Điểm</span></div><div class="ranking-row ranking-row--highlight"><strong>01</strong><span class="ranking-user"><i class="ranking-avatar ranking-avatar--gold">ML</i><b>Mai Linh</b></span><span class="ranking-bar"><i style="width: 92%"></i></span><strong>4,820</strong></div><div class="ranking-row"><strong>02</strong><span class="ranking-user"><i class="ranking-avatar ranking-avatar--blue">TN</i><b>Trần Nam</b></span><span class="ranking-bar"><i style="width: 84%"></i></span><strong>4,360</strong></div><div class="ranking-row"><strong>03</strong><span class="ranking-user"><i class="ranking-avatar ranking-avatar--green">HP</i><b>Hà Phương</b></span><span class="ranking-bar"><i style="width: 76%"></i></span><strong>3,940</strong></div><div class="ranking-row ranking-row--you"><strong>12</strong><span class="ranking-user"><i class="ranking-avatar ranking-avatar--self">NA</i><b>Nguyễn An <small data-i18n="ui.you">Bạn</small></b></span><span class="ranking-bar"><i style="width: 54%"></i></span><strong>2,840</strong></div></div></section>
		</main>
