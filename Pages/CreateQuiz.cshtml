@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Tạo bài kiểm tra";
}

@section Styles {
    <link rel="stylesheet" href="~/css/CreateQuiz.css" />
}

@section Scripts {
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/createquiz.js" defer></script>
}

		<main class="create-quiz-page">
			<header class="create-quiz-header"><div><p class="create-quiz-eyebrow" data-i18n="ui.authoring_tools">Công cụ biên soạn</p><h1 data-i18n="ui.create_a_test">Tạo bài kiểm tra</h1><p data-i18n="ui.create_your_own_practice_content">Tạo nội dung luyện tập của riêng bạn.</p></div><a class="create-quiz-back" href="/Index" data-i18n="ui.back_to_home">Quay lại trang chủ</a></header>
			<form class="quiz-builder" action="#" method="post">
				<section class="quiz-builder__details"><div class="quiz-section-heading"><div><p class="create-quiz-eyebrow" data-i18n="ui.step_1">Bước 1</p><h2 data-i18n="ui.test_details">Thông tin bộ đề</h2></div><span data-i18n="ui.unsaved">Chưa lưu</span></div><div class="quiz-form-grid"><label><span data-i18n="ui.test_title">Tên bài kiểm tra</span><input type="text" name="quizTitle" placeholder="Ví dụ: Từ vựng giao tiếp" data-i18n-placeholder="ui.example_conversational_vocabulary" required></label><label><span data-i18n="ui.topic">Chủ đề</span><select name="quizTopic"><option value="Từ vựng" data-i18n="ui.vocabulary">Từ vựng</option><option value="Ngữ pháp" data-i18n="ui.grammar">Ngữ pháp</option><option value="Nghe hiểu" data-i18n="ui.listening">Nghe hiểu</option></select></label><label class="quiz-form-grid__wide"><span data-i18n="ui.description">Mô tả</span><textarea name="quizDescription" rows="3" placeholder="Mô tả ngắn về bài kiểm tra" data-i18n-placeholder="ui.a_short_description_of_the_test"></textarea></label></div></section>
				<section class="quiz-builder__questions"><div class="quiz-section-heading"><div><p class="create-quiz-eyebrow" data-i18n="ui.step_2">Bước 2</p><h2 data-i18n="ui.question">Câu hỏi</h2></div><span>1 / 10</span></div><article class="quiz-question"><div class="quiz-question__heading"><strong data-i18n="ui.question_01">Câu hỏi 01</strong><button type="button" aria-label="Xóa câu hỏi" data-i18n-aria-label="ui.delete_question" data-i18n="ui.delete">Xóa</button></div><label><span data-i18n="ui.question_text">Nội dung câu hỏi</span><textarea name="question1" rows="3" placeholder="Nhập nội dung câu hỏi..." data-i18n-placeholder="ui.enter_the_question" required></textarea></label><div class="quiz-answers"><label><span class="quiz-answer-key">A</span><input type="text" name="answerA" placeholder="Đáp án A" data-i18n-placeholder="quiz.answer_A" required><input type="radio" name="correctAnswer" value="A" aria-label="Chọn đáp án A" data-i18n-aria-label="quiz.choose_A"></label><label><span class="quiz-answer-key">B</span><input type="text" name="answerB" placeholder="Đáp án B" data-i18n-placeholder="quiz.answer_B" required><input type="radio" name="correctAnswer" value="B" aria-label="Chọn đáp án B" data-i18n-aria-label="quiz.choose_B"></label><label><span class="quiz-answer-key">C</span><input type="text" name="answerC" placeholder="Đáp án C" data-i18n-placeholder="quiz.answer_C" required><input type="radio" name="correctAnswer" value="C" aria-label="Chọn đáp án C" data-i18n-aria-label="quiz.choose_C"></label><label><span class="quiz-answer-key">D</span><input type="text" name="answerD" placeholder="Đáp án D" data-i18n-placeholder="quiz.answer_D" required><input type="radio" name="correctAnswer" value="D" aria-label="Chọn đáp án D" data-i18n-aria-label="quiz.choose_D"></label></div></article><button class="quiz-add-question" type="button" data-i18n="ui.add_question">+ Thêm câu hỏi</button></section>
				<footer class="quiz-builder__actions"><a href="/Index" data-i18n="ui.cancel">Hủy</a><button class="quiz-save-button" type="submit" data-i18n="ui.save_test">Lưu bài kiểm tra</button></footer>
			</form>
		</main>
