@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Học tập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Study.css" />
}

@section Scripts {
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/study.js" defer></script>
}

		<main class="study-page">
			<header class="study-header">
				<div><p class="study-eyebrow" data-i18n="ui.learning_space">Không gian học tập</p><h1 data-i18n="ui.study">Học tập</h1><p data-i18n="ui.choose_a_topic_and_keep_improving_every_day">Chọn một chủ đề để tiếp tục tiến bộ mỗi ngày.</p></div>
				<a class="study-profile" href="/Account/Profile" data-i18n-text="ui.profile">Hồ sơ <span>NA</span></a>
			</header>
			<section class="study-toolbar" aria-label="Bộ lọc bài học" data-i18n-aria-label="ui.lesson_filters"><button class="study-filter study-filter--active" type="button" data-i18n="ui.all">Tất cả</button><button class="study-filter" type="button" data-i18n="ui.vocabulary">Từ vựng</button><button class="study-filter" type="button" data-i18n="ui.grammar">Ngữ pháp</button><button class="study-filter" type="button" data-i18n="ui.listening">Nghe hiểu</button></section>
			<section class="study-grid" aria-label="Danh sách bài học" data-i18n-aria-label="ui.lesson_list">
				<article class="study-card study-card--featured"><div class="study-card__top"><span class="study-card__tag" data-i18n="ui.in_progress">Đang học</span><span data-i18n="ui.25_minutes">25 phút</span></div><h2 data-i18n="ui.everyday_communication">Giao tiếp hằng ngày</h2><p data-i18n="ui.practise_common_expressions_for_everyday_situations">Luyện những câu nói thường dùng trong các tình huống cơ bản.</p><div class="study-progress"><span><i style="width: 64%"></i></span><b>64%</b></div><a href="/TrialTest" data-i18n="ui.continue_lesson">Tiếp tục bài học &#8594;</a></article>
				<article class="study-card"><div class="study-card__top"><span class="study-card__icon study-card__icon--blue">A1</span><span data-i18n="ui.12_lessons">12 bài</span></div><h2 data-i18n="ui.vocabulary_foundations">Từ vựng nền tảng</h2><p data-i18n="ui.essential_vocabulary_for_beginners">Các từ vựng quan trọng cho người mới bắt đầu.</p><a href="/TrialTest" data-i18n="ui.start_learning_link">Bắt đầu học &#8594;</a></article>
				<article class="study-card"><div class="study-card__top"><span class="study-card__icon study-card__icon--green">G</span><span data-i18n="ui.8_lessons">8 bài</span></div><h2 data-i18n="ui.basic_grammar">Ngữ pháp cơ bản</h2><p data-i18n="ui.master_sentence_structure_and_the_present_tense">Nắm vững cấu trúc câu và cách sử dụng thì hiện tại.</p><a href="/TrialTest" data-i18n="ui.start_learning_link">Bắt đầu học &#8594;</a></article>
				<article class="study-card"><div class="study-card__top"><span class="study-card__icon study-card__icon--orange">L</span><span data-i18n="ui.10_lessons">10 bài</span></div><h2 data-i18n="ui.listening_practice">Luyện nghe</h2><p data-i18n="ui.improve_your_listening_through_short_conversations">Cải thiện khả năng nghe qua các đoạn hội thoại ngắn.</p><a href="/TrialTest" data-i18n="ui.start_learning_link">Bắt đầu học &#8594;</a></article>
			</section>
		</main>
