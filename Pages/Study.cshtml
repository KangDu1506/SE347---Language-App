@page
@{
    Layout = "_Layout";
    ViewData["Title"] = "Học tập";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Study.css" />
}

@section Scripts {
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/study.js" defer></script>
}

		<main class="study-page">
			<header class="study-header">
				<div><p class="study-eyebrow">Không gian học tập</p><h1>Học tập</h1><p>Chọn một chủ đề để tiếp tục tiến bộ mỗi ngày.</p></div>
				<a class="study-profile" href="/Account/Profile">Hồ sơ <span>NA</span></a>
			</header>
			<section class="study-toolbar" aria-label="Bộ lọc bài học"><button class="study-filter study-filter--active" type="button">Tất cả</button><button class="study-filter" type="button">Từ vựng</button><button class="study-filter" type="button">Ngữ pháp</button><button class="study-filter" type="button">Nghe hiểu</button></section>
			<section class="study-grid" aria-label="Danh sách bài học">
				<article class="study-card study-card--featured"><div class="study-card__top"><span class="study-card__tag">Đang học</span><span>25 phút</span></div><h2>Giao tiếp hằng ngày</h2><p>Luyện những câu nói thường dùng trong các tình huống cơ bản.</p><div class="study-progress"><span><i style="width: 64%"></i></span><b>64%</b></div><a href="/TrialTest">Tiếp tục bài học &#8594;</a></article>
				<article class="study-card"><div class="study-card__top"><span class="study-card__icon study-card__icon--blue">A1</span><span>12 bài</span></div><h2>Từ vựng nền tảng</h2><p>Các từ vựng quan trọng cho người mới bắt đầu.</p><a href="/TrialTest">Bắt đầu học &#8594;</a></article>
				<article class="study-card"><div class="study-card__top"><span class="study-card__icon study-card__icon--green">G</span><span>8 bài</span></div><h2>Ngữ pháp cơ bản</h2><p>Nắm vững cấu trúc câu và cách sử dụng thì hiện tại.</p><a href="/TrialTest">Bắt đầu học &#8594;</a></article>
				<article class="study-card"><div class="study-card__top"><span class="study-card__icon study-card__icon--orange">L</span><span>10 bài</span></div><h2>Luyện nghe</h2><p>Cải thiện khả năng nghe qua các đoạn hội thoại ngắn.</p><a href="/TrialTest">Bắt đầu học &#8594;</a></article>
			</section>
		</main>
