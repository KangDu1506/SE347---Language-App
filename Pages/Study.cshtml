@page
@using Microsoft.AspNetCore.Hosting
@using System.Text.Json
@using System.Text.RegularExpressions
@using SE347.DTOs.Lesson
@using SE347.Services
@inject IWebHostEnvironment Environment
@*
    Học tập: Bàn cờ lộ trình học tập phân nhánh (Flowchart / Skill Tree), thư viện chủ đề và gợi ý.
    Bàn cờ đọc LearningPath.json; thư viện bài học được nạp từ API.
*@
@{
    Layout = "_Layout";
    ViewData["Title"] = "Học tập";
    var TemplateRoot = System.IO.Path.Combine(Environment.ContentRootPath, "Storage", "LessonTemplate");
    var ProgressiveLearningRoot = System.IO.Path.Combine(TemplateRoot, "ProgressiveLearning-A");
    var BoardNodes = LoadBoardNodes(ProgressiveLearningRoot);
    var CompletedCount = BoardNodes.Count(n => n.State == "done");
    var TotalBoardCount = BoardNodes.Length;
    var MaxCol = BoardNodes.Length > 0 ? BoardNodes.Max(n => n.Column) : 13;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Study.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_SupabaseClient" />
    <script src="~/js/Shared/api.js" asp-append-version="true" defer></script>
    <script src="~/js/auth-guard.js" defer></script>
    <script src="~/js/study.js" asp-append-version="true" defer></script>
}

<main class="study-page">
    <div class="study-wrap">
        <section class="study-head" aria-labelledby="study-title">
            <h1 id="study-title"><span data-i18n="study.title_a">Học</span> <span class="study-head__accent" data-i18n="study.title_b">tập</span></h1>
            <div class="sticker study-level">
                <b>A2</b>
                <p><span data-i18n="study.level_name">Lộ trình Sơ cấp</span><small>@CompletedCount/@TotalBoardCount <span data-i18n="study.lessons_unit">bài</span> · 1.247 <span data-i18n="study.oxford_words">từ Oxford</span></small></p>
            </div>
        </section>

        <!-- BÀN CỜ LỘ TRÌNH PHÂN NHÁNH (GRAPH / FLOWCHART STUDY BOARD) -->
        <section class="sticker study-board" aria-labelledby="study-board-title">
            <div class="study-board__head">
                <div>
                    <span class="tag" data-i18n="study.board_tag">Bàn cờ lộ trình</span>
                    <h2 id="study-board-title" data-i18n="study.board_branch_title">Lộ trình học tập phân nhánh</h2>
                    <div class="study-board__legend" aria-hidden="true">
                        <span class="legend-item"><span class="legend-dot legend-dot--main"></span> <span data-i18n="study.legend_main">Mạch chính</span></span>
                        <span class="legend-item"><span class="legend-dot legend-dot--branch"></span> <span data-i18n="study.legend_branch">Nhánh mở rộng</span></span>
                        <span class="legend-item"><span class="legend-dot legend-dot--current"></span> <span data-i18n="study.legend_current">Đang học</span></span>
                    </div>
                </div>
                <div class="study-board__controls">
                    <span class="study-board__stars-pill">⭐ @CompletedCount/@TotalBoardCount <span data-i18n="study.lessons_completed">bài đã học</span></span>
                    <div class="study-board__btn-group">
                        <button type="button" class="btn btn--sm study-board__nav-btn" id="study-scroll-left" data-i18n-aria-label="study.scroll_left" aria-label="Cuộn sang trái">◀</button>
                        <button type="button" class="btn btn--sm btn--ink study-board__nav-btn" id="study-scroll-current" data-i18n-title="study.scroll_current_title" data-i18n="study.current_position" title="Di chuyển tới bài đang học">Vị trí hiện tại</button>
                        <button type="button" class="btn btn--sm study-board__nav-btn" id="study-scroll-right" data-i18n-aria-label="study.scroll_right" aria-label="Cuộn sang phải">▶</button>
                    </div>
                </div>
            </div>

            <div class="study-board__viewport" id="study-board-viewport" tabindex="0" role="region" data-i18n-aria-label="study.map_aria_label" aria-label="Bản đồ lộ trình học tập">
                <div class="study-board__canvas" id="study-board-canvas" style="--total-cols: @MaxCol;">
                    <!-- Lớp SVG vẽ các đường cong nối Bézier (đã bỏ đầu mũi tên) -->
                    <svg class="study-board__svg" id="study-board-svg" aria-hidden="true"></svg>

                    <!-- Các Node bài học sắp xếp theo cột và hàng nhánh -->
                    @foreach (var node in BoardNodes)
                    {
                        var prereqsJoin = string.Join(",", node.Prerequisites);
                        <article class="study-node study-node--@node.State @(node.IsBranch ? "study-node--branch" : "study-node--main")"
                                 id="node-@node.Id"
                                 data-node-id="@node.Id"
                                 data-level="@node.Level"
                                 data-category="@node.Category"
                                 data-topic="@node.Topic"
                                 data-name="@node.Name"
                                 data-branch="@node.BranchTitle"
                                 data-prereq="@prereqsJoin"
                                 data-col="@node.Column"
                                 data-row="@node.Row"
                                 style="grid-column: @node.Column; grid-row: @(node.Row + 1);">

                            @if (node.State == "current")
                            {
                                <svg class="foxy study-node__token" aria-hidden="true"><use href="/images/mascot/foxy.svg#foxy" /></svg>
                            }

                            <div class="study-node__header">
                                <div class="study-node__tags">
                                    <span class="study-node__pill @(node.IsBranch ? "study-node__pill--branch" : "study-node__pill--main")" data-i18n="@(node.IsBranch ? "study.pill_branch" : "study.pill_main")">
                                        @(node.IsBranch ? "Nhánh" : "Chính")
                                    </span>
                                    <span class="study-node__level">@node.Level</span>
                                </div>
                                <span class="study-node__badge">
                                    @if (node.State == "done")
                                    {
                                        <span class="badge-done" data-i18n-title="study.status_done" title="Đã hoàn thành">✓</span>
                                    }
                                    else if (node.State == "current")
                                    {
                                        <span class="badge-current" data-i18n-title="study.status_current" title="Đang học">▶</span>
                                    }
                                    else
                                    {
                                        <span class="badge-locked" data-i18n-title="study.status_locked" title="Chưa mở khóa">🔒</span>
                                    }
                                </span>
                            </div>

                            <div class="study-node__content">
                                <h3 class="study-node__title" title="@node.Name">@node.Name</h3>
                                <span class="study-node__cat" data-i18n="@(node.Category switch {
                                    "speaking" => "study.cat_speaking",
                                    "grammar" => "ui.grammar",
                                    _ => "ui.vocabulary"
                                })">
                                    @(node.Category switch {
                                        "speaking" => "Giao tiếp",
                                        "grammar" => "Ngữ pháp",
                                        _ => "Từ vựng"
                                    })
                                </span>
                            </div>

                            <div class="study-node__footer">
                                @if (node.State == "done")
                                {
                                    <span class="study-node__status-text study-node__status-text--done" data-i18n="study.done_stars">Đã xong · 3★</span>
                                }
                                else if (node.State == "current")
                                {
                                    <a class="btn btn--sm btn--ink study-node__btn" href="/Lesson/@node.Id" data-i18n="study.btn_start">Vào học →</a>
                                }
                                else
                                {
                                    <span class="study-node__status-text study-node__status-text--locked" data-i18n="study.note_locked">Mở sau bài trước</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>

        <!-- THƯ VIỆN CHỦ ĐỀ & DANH SÁCH BÀI HỌC (ĐÃ LỌC BỎ BÀI KIỂM TRA Ở CUỐI) -->
        <div class="study-lower">
            <aside class="sticker study-lib" data-i18n-aria-label="study.library_aria_label" aria-label="Thư viện chủ đề bài học">
                <div class="study-lib__head">
                    <span class="tag" data-i18n="study.library_tag">Thư viện</span>
                    <button type="button"
                            class="study-lib__toggle-all"
                            id="study-lib-toggle-all"
                            data-state="expand"
                            data-i18n-title="study.toggle_all_title"
                            data-i18n-aria-label="study.toggle_all_label"
                            title="Mở rộng tất cả các danh mục"
                            aria-label="Mở hoặc thu gọn tất cả danh mục">
                        <span class="toggle-all__icon" aria-hidden="true">⊞</span>
                        <span class="toggle-all__text" data-i18n="study.expand_all">Mở tất cả</span>
                    </button>
                </div>

                <!-- THANH TÌM KIẾM BÀI HỌC (BO TRÒN 2 ĐẦU, NÚT TÌM KIẾM NẰM BÊN TRONG SÁT PHẢI) -->
                <div class="study-search-bar" role="search">
                    <span class="study-search-icon-prefix" aria-hidden="true">🔍</span>
                    <input type="text"
                           id="study-search-input"
                           class="study-search-input"
                           data-i18n-placeholder="study.search_placeholder"
                           data-i18n-aria-label="study.search_aria_label"
                           placeholder="Tìm bài học (vd: A1, A2, adjectives, greetings)..."
                           aria-label="Tìm kiếm chủ đề bài học"
                           autocomplete="off" />
                    <button type="button"
                            id="study-search-clear"
                            class="study-search-clear"
                            data-i18n-title="study.search_clear_title"
                            data-i18n-aria-label="study.search_clear_label"
                            title="Xóa nội dung tìm kiếm"
                            aria-label="Xóa nội dung tìm kiếm"
                            hidden>✕</button>
                    <button type="button"
                            id="study-search-btn"
                            class="study-search-btn"
                            data-i18n-title="study.search_btn_title"
                            data-i18n-aria-label="study.search_btn_label"
                            title="Tìm kiếm"
                            aria-label="Thực hiện tìm kiếm">
                        <span data-i18n="study.search_btn_text">Tìm</span>
                    </button>
                </div>

                <!-- KẾT QUẢ TÌM KIẾM PHẲNG: CHỈ HIỆN CÁC BÀI LỚN (TOPIC), KHÔNG HIỆN THỂ LOẠI & NHÓM NỘI DUNG -->
                <div class="study-search-results" id="study-search-results" hidden aria-live="polite">
                    <div class="study-search-meta" id="study-search-meta"></div>
                    <div class="study-search-list" id="study-search-list"></div>
                </div>

                <!-- CÁC THỂ LOẠI VÀ CHỦ ĐỀ MẶC ĐỊNH -->
                <div class="study-lib__categories" id="study-lib-categories" aria-live="polite" aria-busy="true">
                    <p class="study-library-state" id="study-library-state" role="status">Đang tải danh sách bài học...</p>
                    <button class="btn btn--sm" id="study-library-retry" type="button" hidden>Thử lại</button>
                    <div id="study-library-list" hidden></div>
                </div>
            </aside>

            <section class="sticker study-topic" id="study-topic" aria-live="polite">
                <p class="study-library-state" data-library-empty hidden>Chưa có bài học nào.</p>
                <div id="study-topic-panels"></div>
            </section>
        </div>

        <section class="study-recs" aria-labelledby="study-recs-title">
            <div class="study-recs__head">
                <div>
                    <span class="tag" data-i18n="study.standalone_tag">Chuyên đề tự do</span>
                    <h2 id="study-recs-title" data-i18n="study.standalone_title">Gợi ý bài học ngoài lộ trình</h2>
                </div>
                <p data-i18n="study.standalone_desc">3 bài học chuyên sâu về Nghe hiểu, Ngữ pháp và Từ vựng nâng cao sẵn sàng học ngay.</p>
            </div>
            <div class="study-rec-grid">
                <!-- BÀI 1: AT THE COFFEE SHOP (LISTENING) -->
                <article class="sticker press study-rec">
                    <span class="study-rec__hot" data-i18n="study.rec_listening">NGHE HIỂU</span>
                    <div class="study-rec__art study-rec__art--wave" aria-hidden="true">
                        <span class="study-rec__play">▶</span>
                        <span class="study-rec__bars">@foreach (var h in new[] { 30, 70, 45, 90, 55, 80, 35, 65, 95, 50, 75, 40, 60, 85, 30 }) { <i style="--h: @(h)%"></i> }</span>
                        <span class="study-rec__time">0:42</span>
                    </div>
                    <span class="tag" data-i18n="study.rec_listening_tag">Nghe hiểu · A2</span>
                    <h3>At the Coffee Shop</h3>
                    <p data-i18n="study.rec_coffee_desc">Luyện nghe hội thoại thực tế giữa khách hàng và barista tại quán cà phê.</p>
                    <div class="study-rec__row">
                        <span data-i18n="study.rec_coffee_time">8 phút · <b>+16 XP</b></span>
                        <a class="btn btn--sm" href="/Lesson/at-the-coffee-shop" data-i18n="study.learn_now">Học ngay →</a>
                    </div>
                </article>

                <!-- BÀI 2: PRESENT SIMPLE TENSE (GRAMMAR) -->
                <article class="sticker press study-rec">
                    <span class="study-rec__hot" data-i18n="study.rec_grammar">NGỮ PHÁP</span>
                    <div class="study-rec__art study-rec__art--chat" aria-hidden="true" lang="en">
                        <span class="study-bubble">He works at a bank in Hanoi.</span>
                        <span class="study-bubble study-bubble--me">Do you play tennis every Sunday?</span>
                    </div>
                    <span class="tag" data-i18n="study.rec_grammar_tag">Ngữ pháp · A1</span>
                    <h3>Present Simple Tense</h3>
                    <p data-i18n="study.rec_present_desc">Thì hiện tại đơn diễn tả thói quen, chân lý và lịch trình thường nhật.</p>
                    <div class="study-rec__row">
                        <span data-i18n="study.rec_present_time">15 phút · <b>+30 XP</b></span>
                        <a class="btn btn--sm" href="/Lesson/present-simple-tense" data-i18n="study.learn_now">Học ngay →</a>
                    </div>
                </article>

                <!-- BÀI 3: AMBIGUOUS, VAGUE, EQUIVOCAL, OBSCURE (VOCABULARY) -->
                <article class="sticker press study-rec">
                    <span class="study-rec__hot" data-i18n="study.rec_vocab">TỪ VỰNG</span>
                    <div class="study-rec__art study-rec__art--chat" aria-hidden="true" lang="en">
                        <span class="study-bubble">His reply was very ambiguous.</span>
                        <span class="study-bubble study-bubble--me">The instructions remain vague.</span>
                    </div>
                    <span class="tag" data-i18n="study.rec_vocab_tag">Từ vựng · B2</span>
                    <h3>Ambiguous, Vague, Equivocal, Obscure</h3>
                    <p data-i18n="study.rec_ambiguous_desc">Phân biệt 4 tính từ cao cấp chỉ tính chất mơ hồ, khó hiểu và đa nghĩa.</p>
                    <div class="study-rec__row">
                        <span data-i18n="study.rec_ambiguous_time">10 phút · <b>+20 XP</b></span>
                        <a class="btn btn--sm" href="/Lesson/ambiguous-vague-equivocal-obscure" data-i18n="study.learn_now">Học ngay →</a>
                    </div>
                </article>
            </div>
        </section>
    </div>
</main>

@functions {
    public sealed record BoardNode(
        string Id,
        string Name,
        string Category,
        string Level,
        bool IsBranch,
        string BranchTitle,
        int Column,
        int Row,
        string State,
        string[] Prerequisites,
        string Topic = "",
        string Description = ""
    );

    private sealed record Lesson(string Id, string Name, string State);
    private sealed record Topic(
        string Id,
        string Category,
        string Title,
        string Desc,
        Lesson[] Lessons,
        string[] Levels,
        string GroupName
    );
    private sealed record Group(string Name, Topic[] Topics);
    private sealed record Category(string Id, string Icon, string LabelKey, string Label, string Meta, bool Open, Group[] Groups);
    private sealed record CategoryDefinition(string Id, string ConfigCategory, string Icon, string LabelKey, string Label, int Order);
    private sealed record LessonTemplateEntry(string Id, LessonConfigDto Config, string GroupId, int PartNumber, bool IsNumbered);

    private static readonly Dictionary<string, string> NoteText = new()
    {
        ["done"] = "Đã xong · ★★★", ["current"] = "Đang học · +10 XP", ["locked"] = "Mở sau bài trước"
    };

    private static readonly CategoryDefinition[] CategoryDefinitions =
    {
        new("vocab", "vocabulary", "Aa", "ui.vocabulary", "Từ vựng", 1),
        new("grammar", "grammar", "G", "ui.grammar", "Ngữ pháp", 2),
        new("speaking", "speaking", "Hi", "study.cat_speaking", "Giao tiếp", 3),
        new("listening", "listening", "♪", "ui.listening", "Nghe hiểu", 4)
    };

    private static BoardNode[] LoadBoardNodes(string progressiveLearningRoot)
    {
        var pathFile = System.IO.Path.Combine(progressiveLearningRoot, "LearningPath.json");
        if (!System.IO.File.Exists(pathFile))
        {
            return Array.Empty<BoardNode>();
        }

        using var doc = JsonDocument.Parse(System.IO.File.ReadAllText(pathFile));
        var root = doc.RootElement;
        var list = new List<BoardNode>();

        LessonConfigDto? ReadConfig(string lid)
        {
            var cfgPath = System.IO.Path.Combine(progressiveLearningRoot, lid, LessonTemplateValidator.ConfigFile);
            if (!System.IO.File.Exists(cfgPath)) return null;
            try
            {
                return JsonSerializer.Deserialize<LessonConfigDto>(System.IO.File.ReadAllText(cfgPath));
            }
            catch
            {
                return null;
            }
        }

        // 1. Mạch chính (Main Line: Row = 1)
        if (root.TryGetProperty("lessons", out var lessonsElem) && lessonsElem.ValueKind == JsonValueKind.Array)
        {
            var mainLessons = lessonsElem.EnumerateArray().ToArray();
            for (int i = 0; i < mainLessons.Length; i++)
            {
                var item = mainLessons[i];
                var lid = item.GetProperty("lessonId").GetString()!;
                var order = item.GetProperty("order").GetInt32();
                var config = ReadConfig(lid);
                if (config == null) continue;

                var prereqs = i == 0
                    ? Array.Empty<string>()
                    : new[] { mainLessons[i - 1].GetProperty("lessonId").GetString()! };

                var state = order switch
                {
                    1 => "done",
                    2 => "done",
                    3 => "current",
                    _ => "locked"
                };

                list.Add(new BoardNode(
                    lid,
                    config.Name,
                    config.Category,
                    config.Level,
                    IsBranch: false,
                    BranchTitle: string.Empty,
                    Column: order,
                    Row: 1, // Hàng giữa
                    State: state,
                    Prerequisites: prereqs,
                    Topic: config.Topic ?? string.Empty,
                    Description: config.Description ?? string.Empty
                ));
            }
        }

        // 2. Các nhánh mở rộng (Branches: Row 0 là nhánh trên, Row 2 là nhánh dưới)
        var branchCoords = new Dictionary<string, (int Col, int Row, string BranchName)>(StringComparer.OrdinalIgnoreCase)
        {
            ["ordinal-numbers"] = (4, 0, "Số thứ tự & Thời gian"),
            ["time"] = (5, 0, "Số thứ tự & Thời gian"),
            ["basic-foods-and-drinks-2"] = (7, 2, "Ẩm thực mở rộng"),
            ["locations-and-destinations-2"] = (8, 0, "Địa điểm du lịch"),
            ["occupations-2"] = (9, 2, "Nghề nghiệp nâng cao")
        };

        if (root.TryGetProperty("branches", out var branchesElem) && branchesElem.ValueKind == JsonValueKind.Array)
        {
            foreach (var branch in branchesElem.EnumerateArray())
            {
                var branchTitle = branch.TryGetProperty("title", out var bt) ? bt.GetString() ?? "" : "";
                if (branch.TryGetProperty("lessons", out var branchLessons) && branchLessons.ValueKind == JsonValueKind.Array)
                {
                    foreach (var bl in branchLessons.EnumerateArray())
                    {
                        var lid = bl.GetProperty("lessonId").GetString()!;
                        var config = ReadConfig(lid);
                        if (config == null) continue;

                        var prereqsList = new List<string>();
                        if (bl.TryGetProperty("prerequisites", out var preElem) && preElem.ValueKind == JsonValueKind.Array)
                        {
                            foreach (var p in preElem.EnumerateArray())
                            {
                                var s = p.GetString();
                                if (!string.IsNullOrEmpty(s)) prereqsList.Add(s);
                            }
                        }

                        int col = 4;
                        int row = 0;
                        if (branchCoords.TryGetValue(lid, out var coord))
                        {
                            col = coord.Col;
                            row = coord.Row;
                            if (!string.IsNullOrEmpty(coord.BranchName)) branchTitle = coord.BranchName;
                        }

                        list.Add(new BoardNode(
                            lid,
                            config.Name,
                            config.Category,
                            config.Level,
                            IsBranch: true,
                            BranchTitle: branchTitle,
                            Column: col,
                            Row: row,
                            State: "locked",
                            Prerequisites: prereqsList.ToArray(),
                            Topic: config.Topic ?? string.Empty,
                            Description: config.Description ?? string.Empty
                        ));
                    }
                }
            }
        }

        return list.ToArray();
    }

    private static Category[] LoadCategories(string templateRoot, string progressiveLearningRoot, BoardNode[] boardNodes)
    {
        var boardNodeMap = boardNodes.ToDictionary(n => n.Id, StringComparer.OrdinalIgnoreCase);

        var folders = new List<string>();
        if (Directory.Exists(progressiveLearningRoot))
        {
            folders.AddRange(Directory.EnumerateDirectories(progressiveLearningRoot));
        }
        if (Directory.Exists(templateRoot))
        {
            var standalone = Directory.EnumerateDirectories(templateRoot)
                .Where(folder =>
                {
                    var name = System.IO.Path.GetFileName(folder) ?? string.Empty;
                    return !string.Equals(name, "ProgressiveLearning-A", StringComparison.OrdinalIgnoreCase)
                        && !string.Equals(name, "schemas", StringComparison.OrdinalIgnoreCase);
                });
            folders.AddRange(standalone);
        }

        if (folders.Count == 0) return Array.Empty<Category>();

        var entries = folders
            .Where(folder =>
            {
                var configPath = System.IO.Path.Combine(folder, LessonTemplateValidator.ConfigFile);
                if (!System.IO.File.Exists(configPath)) return false;

                var name = System.IO.Path.GetFileName(folder) ?? string.Empty;
                // Lọc bỏ các bài test / template kiểm tra
                if (name.Contains("test", StringComparison.OrdinalIgnoreCase) ||
                    name.Contains("quiz", StringComparison.OrdinalIgnoreCase))
                {
                    return false;
                }
                return true;
            })
            .Select(folder =>
            {
                var id = System.IO.Path.GetFileName(folder)
                    ?? throw new InvalidDataException($"Không xác định được tên thư mục bài học: {folder}");
                var configPath = System.IO.Path.Combine(folder, LessonTemplateValidator.ConfigFile);
                var config = JsonSerializer.Deserialize<LessonConfigDto>(System.IO.File.ReadAllText(configPath))
                    ?? throw new InvalidDataException($"Config bài học không hợp lệ: {configPath}");

                var folderPartMatch = Regex.Match(id, @"^(?<group>.+)-(?<part>[1-9]\d*)$");
                var namePartMatch = Regex.Match(config.Name, @"^(?<group>.+?)\s+(?<part>[1-9]\d*)$");
                var isNumbered = folderPartMatch.Success || namePartMatch.Success;
                var groupId = folderPartMatch.Success
                    ? folderPartMatch.Groups["group"].Value
                    : namePartMatch.Success
                        ? ToSlug(namePartMatch.Groups["group"].Value)
                        : id;
                var partNumber = folderPartMatch.Success
                    ? int.Parse(folderPartMatch.Groups["part"].Value)
                    : namePartMatch.Success
                        ? int.Parse(namePartMatch.Groups["part"].Value)
                        : 0;

                return new LessonTemplateEntry(
                    id,
                    config,
                    groupId,
                    partNumber,
                    isNumbered);
            })
            .ToArray();

        return CategoryDefinitions
            .OrderBy(definition => definition.Order)
            .Select(definition =>
            {
                var categoryEntries = entries
                    .Where(entry => entry.Config.Category == definition.ConfigCategory)
                    .ToArray();

                var groups = categoryEntries
                    .GroupBy(entry => entry.Config.Topic)
                    .OrderBy(group => group.Min(entry => entry.Config.Order))
                    .Select(topicGroup => new Group(
                        topicGroup.Key,
                        topicGroup
                            .GroupBy(entry => entry.GroupId)
                            .OrderBy(group => group.Min(entry => entry.Config.Order))
                            .Select(group =>
                            {
                                // LỌC BỎ BÀI KIỂM TRA NẰM Ở CUỐI HOẶC TRONG MỤC NỘI DUNG
                                var orderedLessons = group
                                    .Where(entry => !entry.Id.Contains("test", StringComparison.OrdinalIgnoreCase)
                                                 && !entry.Config.Name.Contains("kiểm tra", StringComparison.OrdinalIgnoreCase)
                                                 && !entry.Config.Name.Contains("test", StringComparison.OrdinalIgnoreCase)
                                                 && !entry.Config.Name.Contains("quiz", StringComparison.OrdinalIgnoreCase)
                                                 && !entry.Config.Name.Contains("ôn tập", StringComparison.OrdinalIgnoreCase))
                                    .OrderBy(entry => entry.IsNumbered ? entry.PartNumber : entry.Config.Order)
                                    .ThenBy(entry => entry.Config.Order)
                                    .ThenBy(entry => entry.Id, StringComparer.Ordinal)
                                    .ToArray();

                                if (orderedLessons.Length == 0) return null;

                                var first = orderedLessons[0];
                                var numberedGroup = orderedLessons.Any(entry => entry.IsNumbered);
                                var title = numberedGroup
                                    ? Regex.Replace(first.Config.Name, @"\s+\d+(?::.*)?$", "").Trim()
                                    : first.Config.Name;
                                var topicId = $"{definition.Id}-{ToSlug(topicGroup.Key)}-{first.GroupId}";
                                
                                // ĐỒNG BỘ 100% BÀI THUỘC LỘ TRÌNH VỚI BOARD (TÊN VÀ TRẠNG THÁI) (YÊU CẦU 2)
                                var lessons = orderedLessons
                                    .Select(entry =>
                                    {
                                        if (boardNodeMap.TryGetValue(entry.Id, out var bNode))
                                        {
                                            return new Lesson(
                                                entry.Id,
                                                bNode.Name, // Tên bài học đồng bộ hoàn toàn với Board
                                                bNode.State // Trạng thái ("done", "current", "locked") đồng bộ với Board
                                            );
                                        }

                                        // Bài ngoài lộ trình: mở sẵn "current" để học tự do
                                        return new Lesson(
                                            entry.Id,
                                            entry.Config.Name,
                                            "current"
                                        );
                                    })
                                    .ToArray();

                                var description = string.Join(" ", orderedLessons
                                    .Select(entry => entry.Config.Description)
                                    .Distinct(StringComparer.Ordinal));

                                var levels = orderedLessons
                                    .Select(entry => entry.Config.Level)
                                    .Where(l => !string.IsNullOrEmpty(l))
                                    .Distinct(StringComparer.OrdinalIgnoreCase)
                                    .ToArray();

                                return new Topic(topicId, topicGroup.Key, title, description, lessons, levels, topicGroup.Key);
                            })
                            .Where(topic => topic != null)
                            .Select(topic => topic!)
                            .ToArray()))
                    .Where(group => group.Topics.Length > 0)
                    .ToArray();

                var totalLessons = groups.Sum(g => g.Topics.Sum(t => t.Lessons.Length));
                return (definition, groups, LessonCount: totalLessons);
            })
            .Where(category => category.LessonCount > 0)
            .Select(category => new Category(
                category.definition.Id,
                category.definition.Icon,
                category.definition.LabelKey,
                category.definition.Label,
                category.LessonCount.ToString(),
                false, // Mặc định đóng tất cả mục trong thư viện (Yêu cầu 1)
                category.groups))
            .ToArray();
    }

    private static string ToSlug(string value) =>
        Regex.Replace(value.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
}
