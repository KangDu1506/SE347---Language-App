@*
    Footer dùng chung (SCRUM-32), render trong _Layout.
    Ẩn footer: ViewData["ShowFooter"] = false.
*@
<footer class="site-footer">
    <div class="site-footer__inner">
        <partial name="_Brand" />
        <p>&copy; @DateTime.Now.Year Wordfox · <span data-i18n="footer.description">Học từ vựng Oxford 3000</span></p>
        <nav class="site-footer__links" aria-label="Liên kết phụ" data-i18n-aria-label="ui.additional_links">
            <a href="/Account/Terms"><span data-i18n="ui.terms_of_use">Điều khoản sử dụng</span></a>
        </nav>
    </div>
</footer>
