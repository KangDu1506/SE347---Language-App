@*
    Layout dùng chung cho các trang Razor. Cách dùng trong một trang:

        @{
            Layout = "_Layout";
            ViewData["Title"] = "Trang chủ";
        }

        @section Styles {
            <link rel="stylesheet" href="~/css/index.css" />
        }

        @section Scripts {
            <script src="~/js/index.js" defer></script>
        }
*@
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>@(ViewData["Title"] ?? "SE347 Language App")</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;700;800&display=swap" />
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css" />
        <link rel="stylesheet" href="~/css/Shared/Components.css" />
        @await RenderSectionAsync("Styles", required: false)
    </head>
    <body>
        @RenderBody()

        <script src="~/js/Shared/toast.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
