@*
    Layout dùng chung cho các trang Razor. Cách dùng trong một trang:

        @{
            Layout = "_Layout";
            ViewData["Title"] = "Trang chủ";
        }

        @section Styles {
            <link rel="stylesheet" href="~/css/index.css" />
        }

        @section Scripts {
            <script src="~/js/index.js" defer></script>
        }

    Ẩn header/footer (mặc định hiện):
        ViewData["ShowHeader"] = false;
        ViewData["ShowFooter"] = false;
*@
@{
    var showHeader = ViewData["ShowHeader"] as bool? ?? true;
    var showFooter = ViewData["ShowFooter"] as bool? ?? true;
    var bodyClass = string.Join(" ", new[]
    {
        showHeader || showFooter ? "has-site-chrome" : null,
        showHeader ? "has-site-header" : null
    }.Where(c => c is not null));
}
<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="UTF-8">
        <partial name="_PreferencesHead" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title data-i18n="@(ViewContext.RouteData.Values["page"]?.ToString() switch { "/Index" => "ui.home", "/Study" => "ui.study", "/Ranking" => "ui.leaderboard", "/Account/Profile" => "ui.profile", "/CreateQuiz" => "ui.create_a_test", "/TrialTest" => "ui.try_a_test", "/Lesson" => "lesson.page_title", _ => "" })" data-i18n-suffix=" · Wordfox">@(ViewData["Title"] is string title ? $"{title} · Wordfox" : "Wordfox")</title>
        <partial name="_SharedHead" />
        <link rel="stylesheet" href="~/assets/_colorpalettes/themes.css" />
        <link rel="stylesheet" href="~/css/Shared/Components.css" />
        <link rel="stylesheet" href="~/css/Shared/Layout.css" />
        @await RenderSectionAsync("Styles", required: false)
        <link rel="stylesheet" href="~/css/Shared/Preferences.css" asp-append-version="true" />
    </head>
    <body class="@(string.IsNullOrEmpty(bodyClass) ? null : bodyClass)">
        @if (showHeader)
        {
            <partial name="_Header" />
        }

        @RenderBody()

        @if (showFooter)
        {
            <partial name="_Footer" />
        }

        <script src="~/js/Shared/toast.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
