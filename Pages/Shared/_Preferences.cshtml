<div class="app-preferences" role="group" aria-label="Tùy chọn giao diện" data-i18n-aria-label="settings.preferences">
    <button class="app-preferences__language" type="button" data-language-toggle aria-label="Chuyển sang tiếng Anh" title="Chuyển sang tiếng Anh">
        <img class="app-preferences__flag app-preferences__vi" src="~/images/flags/vi.svg" alt="" aria-hidden="true" width="24" height="16" />
        <img class="app-preferences__flag app-preferences__en" src="~/images/flags/gb.svg" alt="" aria-hidden="true" width="24" height="16" />
        <span class="app-preferences__vi" lang="vi">Tiếng Việt</span>
        <span class="app-preferences__en" lang="en">English</span>
        <svg class="app-preferences__swap" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h15m-4-4 4 4-4 4M20 16H5m4-4-4 4 4 4" /></svg>
    </button>
    <button class="app-preferences__theme" type="button" data-theme-toggle aria-pressed="false" aria-label="Đổi giao diện" data-i18n-aria-label="theme_toggle" title="Đổi giao diện" data-i18n-title="theme_toggle">
        <svg class="app-preferences__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
        <svg class="app-preferences__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20.5 14A9 9 0 0 1 10 3.5 9 9 0 1 0 20.5 14Z" /></svg>
    </button>
</div>
