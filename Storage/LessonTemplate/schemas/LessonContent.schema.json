{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://se347-language-app.local/schemas/LessonContent.schema.json",
    "title": "Lesson Content",
    "description": "Items of a lesson: words (vocabulary), structures (grammar) or sentences to listen to (listening).",
    "type": "array",
    "minItems": 1,
    "items": {
        "$ref": "#/$defs/contentItem"
    },
    "$defs": {
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "contentItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "content",
                "definition-en",
                "definition-vi",
                "examples"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "content": {
                    "$ref": "#/$defs/nonEmptyString",
                    "description": "The word, the grammar structure or the sentence learners hear."
                },
                "pronunciation-bre": {
                    "type": "string",
                    "description": "IPA, British English."
                },
                "pronunciation-name": {
                    "type": "string",
                    "description": "IPA, North American English."
                },
                "definition-en": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "definition-vi": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "oxford-link": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://www\\.oxfordlearnersdictionaries\\.com/"
                },
                "external-source": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "format": "uri"
                    }
                },
                "image": {
                    "type": "string",
                    "pattern": "^\\./[A-Za-z0-9_./-]+\\.(webp|png|jpg|jpeg|svg)$",
                    "description": "Optional image, relative to the lesson folder."
                },
                "audio": {
                    "type": "string",
                    "pattern": "^\\./[A-Za-z0-9_./-]+\\.(mp3|m4a|ogg|wav)$",
                    "description": "Optional audio, relative to the lesson folder. Required in practice for listening lessons."
                },
                "examples": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "term",
                            "translation"
                        ],
                        "properties": {
                            "term": {
                                "$ref": "#/$defs/nonEmptyString"
                            },
                            "translation": {
                                "$ref": "#/$defs/nonEmptyString"
                            }
                        }
                    }
                },
                "synonyms": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                },
                "antonyms": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                }
            }
        }
    }
}
