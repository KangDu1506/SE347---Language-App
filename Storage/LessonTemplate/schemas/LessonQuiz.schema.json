{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://se347-language-app.local/schemas/LessonQuiz.schema.json",
    "title": "Lesson Quiz",
    "description": "Quiz questions associated with a lesson.",
    "type": "array",
    "minItems": 1,
    "items": {
        "$ref": "#/$defs/question"
    },
    "$defs": {
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "question": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "question",
                "answer",
                "explanation",
                "translation"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "fill-in-the-blank",
                        "multiple-choice",
                        "single-choice",
                        "true-false"
                    ],
                    "description": "The interaction type used by the quiz question."
                },
                "question": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "options": {
                    "type": "array",
                    "description": "Available choices or pairs used by the question type.",
                    "minItems": 1,
                    "items": {
                        "oneOf": [
                            {
                                "$ref": "#/$defs/nonEmptyString"
                            }
                        ]
                    }
                },
                "answer": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                },
                "explanation": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "translation": {
                    "$ref": "#/$defs/nonEmptyString"
                }
            }
        }
    }
}
