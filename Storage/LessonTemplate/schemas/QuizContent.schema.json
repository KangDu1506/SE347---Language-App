{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://se347-language-app.local/schemas/QuizContent.schema.json",
    "title": "Quiz Content",
    "description": "Quiz questions. answer/explanation/translation must not be exposed before grading. Audio paths may use mp3, m4a, ogg, or wav.",
    "type": "array",
    "minItems": 0,
    "items": {
        "$ref": "#/$defs/question"
    },
    "$defs": {
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "question": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "question",
                "answer",
                "explanation",
                "translation"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "fill-in-the-blank",
                        "multiple-choice",
                        "single-choice",
                        "true-false"
                    ],
                    "description": "The interaction type used by the quiz question."
                },
                "question": {
                    "$ref": "#/$defs/nonEmptyString",
                    "description": "For fill-in-the-blank, mark each blank with <blank>; one answer per blank, in order."
                },
                "audio": {
                    "type": "string",
                    "pattern": "^\\./[A-Za-z0-9_./-]+\\.(mp3|m4a|ogg|wav)$",
                    "description": "Optional audio played with the question, relative to the quiz or lesson folder."
                },
                "image": {
                    "type": "string",
                    "pattern": "^\\./[A-Za-z0-9_./-]+\\.(webp|png|jpg|jpeg|svg)$",
                    "description": "Optional image shown with the question, relative to the quiz or lesson folder."
                },
                "text": {
                    "type": "string",
                    "pattern": "^\\./[A-Za-z0-9_./-]+\\.txt$",
                    "description": "Optional path to a supporting plain-text file, relative to the quiz or lesson folder."
                },
                "options": {
                    "type": "array",
                    "description": "Choices shown to the learner.",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                },
                "answer": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/nonEmptyString"
                    }
                },
                "explanation": {
                    "$ref": "#/$defs/nonEmptyString"
                },
                "translation": {
                    "$ref": "#/$defs/nonEmptyString"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": { "type": { "enum": ["multiple-choice", "single-choice"] } }
                    },
                    "then": {
                        "required": ["options"]
                    }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "single-choice" } }
                    },
                    "then": {
                        "properties": { "answer": { "maxItems": 1 } }
                    }
                },
                {
                    "if": {
                        "properties": { "type": { "const": "true-false" } }
                    },
                    "then": {
                        "properties": {
                            "options": false,
                            "answer": {
                                "maxItems": 1,
                                "items": { "enum": ["true", "false"] }
                            }
                        }
                    }
                }
            ]
        }
    }
}
