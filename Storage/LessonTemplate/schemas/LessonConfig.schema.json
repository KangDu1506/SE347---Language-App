{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://se347-language-app.local/schemas/LessonConfig.schema.json",
    "title": "Lesson Config",
    "description": "Metadata of a lesson. The lesson folder name (kebab-case slug) is the LessonId.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "category",
        "topic",
        "description",
        "level",
        "order",
        "estimated-minutes",
        "content"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "format": "uri-reference"
        },
        "name": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Display name of the lesson."
        },
        "category": {
            "type": "string",
            "enum": ["vocabulary", "grammar", "listening"],
            "description": "Lesson type, matches the filters on the Study page."
        },
        "topic": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "Subject of the lesson, e.g. \"Adjectives\", \"Tenses\", \"Daily life\"."
        },
        "description": {
            "$ref": "#/$defs/nonEmptyString",
            "description": "A short description of the lesson."
        },
        "level": {
            "type": "string",
            "pattern": "^(A1|A2|B1|B2|C1)$",
            "description": "CEFR level, matches user_learning_profiles.cefr_level in the database."
        },
        "order": {
            "type": "integer",
            "minimum": 1,
            "description": "Position of the lesson in the learning path (1 = first)."
        },
        "estimated-minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120,
            "description": "Estimated time to finish the lesson, in minutes."
        },
        "image": {
            "$ref": "#/$defs/assetPath",
            "description": "Optional cover image, relative to the lesson folder (e.g. \"./images/cover.webp\")."
        },
        "content-settings": {
            "type": "object",
            "description": "Settings for lesson content.",
            "additionalProperties": true
        },
        "quiz-settings": {
            "type": "object",
            "description": "Settings for the quiz.",
            "additionalProperties": false,
            "properties": {
                "mix-with-lesson": {
                    "type": "boolean"
                },
                "randomize-questions": {
                    "type": "boolean"
                },
                "shuffle-questions": {
                    "type": "boolean"
                },
                "shuffle-answers": {
                    "type": "boolean"
                }
            }
        },
        "content": {
            "$ref": "#/$defs/jsonFilePath",
            "description": "Path to the content file, relative to the lesson folder."
        },
        "quiz": {
            "$ref": "#/$defs/jsonFilePath",
            "description": "Path to the quiz file, relative to the lesson folder. Omit if the lesson has no quiz."
        }
    },
    "$defs": {
        "nonEmptyString": {
            "type": "string",
            "minLength": 1
        },
        "jsonFilePath": {
            "type": "string",
            "pattern": "^\\./[A-Za-z0-9_./-]+\\.json$"
        },
        "assetPath": {
            "type": "string",
            "pattern": "^\\./[A-Za-z0-9_./-]+\\.(webp|png|jpg|jpeg|svg)$"
        }
    }
}
